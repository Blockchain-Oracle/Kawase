{
  "expo": {
    "name": "Kawase",
    "slug": "kawase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "kawase",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/icon.png",
      "bundleIdentifier": "xyz.kawase.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Kawase uses Face ID to approve your daily allowance and anything above it."
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/brand/android-foreground.png",
        "backgroundImage": "./assets/brand/android-background.png",
        "monochromeImage": "./assets/brand/android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "xyz.kawase.app",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/brand/favicon.png",
      "name": "Kawase",
      "shortName": "Kawase",
      "description": "An AI money app for everything on Arc.",
      "themeColor": "#F5F5F5",
      "backgroundColor": "#F5F5F5"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F5",
          "image": "./assets/brand/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
              "./node_modules/@expo-google-fonts/roboto-condensed/900Black/RobotoCondensed_900Black.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Roboto Condensed",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/roboto-condensed/900Black/RobotoCondensed_900Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kawase uses Face ID to approve your weekly budget and anything outside it."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Kawase hears you only while you talk to it, to answer you."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-icon.png",
          "color": "#111111",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kawase hears you only while you talk to it, to answer you.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kawase uses the camera to scan payment QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Kawase reads your contacts only when you choose people to import, and checks who is on Kawase only if you agree."
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "abu.dev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9dc112f0-be08-4556-8cb1-f6ad4bbefc70",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "9dc112f0-be08-4556-8cb1-f6ad4bbefc70"
      }
    }
  }
}
