# Copy to .env (never commit). Each app loads only its own keys via @kawase/env.
DATABASE_URL=postgres://kawase:kawase@localhost:5433/kawase
DBOS_SYSTEM_DATABASE_URL=postgres://kawase:kawase@localhost:5433/kawase_dbos
# AI providers (D29: provider-agnostic). Set the key for whichever provider your KAWASE_MODEL_* values use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional per-role overrides, e.g. anthropic:claude-sonnet-5-5
KAWASE_MODEL_AGENT_CHAT=
KAWASE_MODEL_AGENT_VOICE=
KAWASE_MODEL_UTILITY=
# Circle (the agent's developer-controlled wallets, App Kit, webhooks): TEST key always; LIVE key only in production (mainnet fails closed without it)
CIRCLE_TEST_API_KEY=
CIRCLE_LIVE_API_KEY=
CIRCLE_TEST_ENTITY_SECRET=
CIRCLE_LIVE_ENTITY_SECRET=
MAINNET_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=
# Developer machines only (21st.dev component installs), never in CI or runtime
API_KEY_21ST=
ELEVENLABS_API_KEY=

# Sign-in and the user's wallet: Privy (D41). The EXPO_PUBLIC_ values are safe to ship in the app.
EXPO_PUBLIC_PRIVY_APP_ID=
# The native app's client id (Privy dashboard → App clients); the web's own client id is optional.
EXPO_PUBLIC_PRIVY_CLIENT_ID=
EXPO_PUBLIC_PRIVY_WEB_CLIENT_ID=
# Server-side, api only: the same app id; the token verification key (ES256 PEM, one line with \n) is read from Privy's
# public app config when unset; the app secret only reads a user whose identity token was not sent.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
PRIVY_APP_SECRET=
# Local development only: EXPO_PUBLIC_WALLET_PROVIDER=dev with KAWASE_DEV_AUTH=true on the api (throwaway testnet keys).
EXPO_PUBLIC_WALLET_PROVIDER=
# The relayer pays for EIP-7702 setups (spike 15); the ops wallet redeems allowances (a Circle developer-controlled wallet).
RELAYER_PRIVATE_KEY_TESTNET=
RELAYER_PRIVATE_KEY_MAINNET=
OPS_WALLET_ID_TESTNET=
OPS_WALLET_ADDRESS_TESTNET=
OPS_WALLET_ID_MAINNET=
OPS_WALLET_ADDRESS_MAINNET=
# Browser origins allowed to call the api (the web app), comma-separated
KAWASE_WEB_ORIGINS=
# Optional RPC overrides
ARC_RPC_URL_TESTNET=
ARC_RPC_URL_MAINNET=
