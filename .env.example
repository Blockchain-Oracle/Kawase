# Copy to .env (never commit). Each app loads only its own keys via @kawase/env.
DATABASE_URL=postgres://kawase:kawase@localhost:5433/kawase
DBOS_SYSTEM_DATABASE_URL=postgres://kawase:kawase@localhost:5433/kawase_dbos
BETTER_AUTH_SECRET=
# AI providers (D29: provider-agnostic). Set the key for whichever provider your KAWASE_MODEL_* values use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional per-role overrides, e.g. anthropic:claude-sonnet-5-5
KAWASE_MODEL_AGENT_CHAT=
KAWASE_MODEL_AGENT_VOICE=
KAWASE_MODEL_UTILITY=
# Circle (the agent's developer-controlled wallets, App Kit, webhooks): TEST key always; LIVE key only in production (mainnet fails closed without it)
CIRCLE_TEST_API_KEY=
CIRCLE_LIVE_API_KEY=
CIRCLE_TEST_ENTITY_SECRET=
CIRCLE_LIVE_ENTITY_SECRET=
MAINNET_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=
# Developer machines only (21st.dev component installs), never in CI or runtime
API_KEY_21ST=
ELEVENLABS_API_KEY=

# User wallets (Turnkey; D33). The two EXPO_PUBLIC_ values are safe to ship in the app.
EXPO_PUBLIC_TURNKEY_ORGANIZATION_ID=
EXPO_PUBLIC_TURNKEY_AUTH_PROXY_CONFIG_ID=
# Server-side Turnkey API key for the parent organization (relayer wallet, policies). Never in the app.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Passkey relying-party domain (a real domain Abu controls; a passkey is tied to it for life).
EXPO_PUBLIC_PASSKEY_RP_ID=
