{
  "name": "@kawase/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, repositories, outbox transaction helper, committed migrations. Server-only.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@kawase/config": "workspace:*",
    "@kawase/networks": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "uuidv7": "catalog:"
  }
}
